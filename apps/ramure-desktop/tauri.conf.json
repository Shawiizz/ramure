{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ramure",
  "identifier": "com.shawiizz.ramure",
  "build": {
    "frontendDist": "../../frontend/dist/frontend/browser",
    "devUrl": "http://localhost:4400",
    "beforeDevCommand": { "script": "pnpm start", "cwd": "../../frontend" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../frontend" }
  },
  "app": {
    "windows": [
      {
        "title": "Ramure",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBREQ3QUFBNDRGQ0Y4MUEKUldRYStQeEVxbnJkcWxzQmVrbCtrQnJTQ01SU0xlMUdEcS9mZ1l4YVNhamswM3Rqcm81NXo5bDkK",
      "endpoints": ["https://github.com/Shawiizz/ramure/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Shawiizz",
    "shortDescription": "Git client",
    "category": "DeveloperTool",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    }
  }
}
